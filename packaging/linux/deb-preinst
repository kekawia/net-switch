#!/bin/sh
set -eu
case "$1" in
install) # A full custom unit or unmanaged executable must not be replaced by the package.
for unit in netswitch.socket netswitch.service netswitch-engine.service; do
    path=/etc/systemd/system/$unit
    if [ -e "$path" ] || [ -L "$path" ]; then
        [ "$(readlink "$path" || :)" = /dev/null ] || {
            echo "Move the manual $path aside before installing Net Switch." >&2
            exit 1
        }
    fi
done
    if [ -e /usr/lib/netswitch/netswitchctl ]; then echo "Existing manual Net Switch installation" >&2; exit 1; fi ;;
esac
